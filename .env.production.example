# MOBILE app, served at https://m.laidoffcircle.com
# AUTH_APP_ORIGIN must be https://m.laidoffcircle.com (sign-in checks the request origin).
# Add https://m.laidoffcircle.com/__/auth/handler as a redirect URI on the Google OAuth web client too,
# and https://m.laidoffcircle.com/* to the Maps key's allowed referrers.
# Also add m.laidoffcircle.com to the backend CORS_ORIGINS (needed for the WebSocket).

# PRODUCTION. Copy to .env.production on the build machine/server (git-ignored).
# NEXT_PUBLIC_* values are baked in at BUILD time: set them, then run `npm run build`.

# Server-only API address. Backend on the same server, behind the proxy.
BACKEND_API_URL=http://127.0.0.1:9090/api/v1

# Public site origin (needed behind a reverse proxy so cookies/redirects use https).
AUTH_APP_ORIGIN=https://m.laidoffcircle.com

# Firebase web app config (public identifiers).
# AUTH_DOMAIN is our own domain; next.config.mjs proxies /__/auth/* to firebaseapp.com.
# Also add https://laidoffcircle.com/__/auth/handler as a redirect URI on the OAuth web client.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=m.laidoffcircle.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=laidoffcircle
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps key, restricted to https://laidoffcircle.com/* and https://www.laidoffcircle.com/*.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Live messages/notifications. The browser connects here directly, so it must be
# publicly reachable; proxy /ws to the backend (WebSocket upgrade) in nginx/Caddy.
NEXT_PUBLIC_WS_URL=wss://m.laidoffcircle.com/ws

# Where the "Desktop site" link points.
# NEXT_PUBLIC_DESKTOP_SITE_ORIGIN=https://laidoffcircle.com
